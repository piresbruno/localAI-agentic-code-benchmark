{
  "name": "deskboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Meeting room booking app — Express 5 API + React 18 SPA over in-memory repositories",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @deskboard/shared && npm run build -w @deskboard/server && npm run build -w @deskboard/client",
    "start": "node server/dist/main.js",
    "dev": "node --watch-path=server/src --exec \"npm run build -w @deskboard/server && npm start\"",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.20.0",
    "globals": "^15.14.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.2.4"
  }
}
