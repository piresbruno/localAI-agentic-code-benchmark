# macOS metadata
._*
.DS_Store

# Editor noise
*.swp
.idea/
.vscode/

# Build/dependency junk generated inside run projects (agents must not commit these)
node_modules/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/
bin/
obj/
coverage/
.coverage
*.egg-info/

# results/ holds the ACTIVE run only. Completed runs are archived (untracked) to
# results-archive/ so future agents never see prior implementations; the permanent
# record is the results log in BENCHMARKS.md + results/RESULTS.md.
results-archive/
