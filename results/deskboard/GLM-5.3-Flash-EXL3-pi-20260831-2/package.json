{
  "name": "deskboard",
  "version": "2.0.0",
  "private": true,
  "description": "DeskBoard — internal meeting-room booking app (REST API + React UI)",
  "scripts": {
    "build": "npm run build --workspace @deskboard/shared && npm run build --workspace @deskboard/server && npm run build --workspace @deskboard/client",
    "prestart": "npm run build",
    "start": "node server/dist/main.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.9"
  }
}
