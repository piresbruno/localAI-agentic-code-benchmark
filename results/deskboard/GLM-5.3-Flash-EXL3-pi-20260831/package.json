{
  "name": "deskboard",
  "version": "1.0.0",
  "private": true,
  "description": "Meeting-room booking app (Express 5 API + React 18 UI, in-memory persistence)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "start": "npm run build && node server/dist/main.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings 0"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.17.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
