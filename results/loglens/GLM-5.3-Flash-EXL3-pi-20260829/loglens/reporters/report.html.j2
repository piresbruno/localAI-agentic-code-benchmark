<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LogLens Report</title>
<style>
  :root {
    --bg: #f6f7f9; --surface: #ffffff; --border: #d4d7dd; --text: #1a202c; --muted: #4a5261;
    --primary: #1d4ed8; --critical: #b91c1c; --warn: #b45309; --info: #1e58af; --ok: #15803d;
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Segoe UI', system-ui, sans-serif; color: var(--text); background: var(--bg); line-height: 1.5; }
  .container { max-width: 1080px; margin: 0 auto; padding: 32px 24px 64px; }
  h1 { font-size: 1.625rem; margin: 0 0 4px; }
  h2 { font-size: 1.25rem; margin: 32px 0 12px; }
  .generated { color: var(--muted); font-size: 0.875rem; margin: 0 0 24px; }
  .cards { display: flex; gap: 16px; flex-wrap: wrap; }
  .card { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 16px 24px; min-width: 160px; flex: 1; }
  .card .value { font-size: 1.75rem; font-weight: 700; }
  .card .label { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; }
  table { width: 100%; border-collapse: collapse; background: var(--surface); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
  th { text-align: left; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); background: var(--bg); padding: 12px 16px; border-bottom: 1px solid var(--border); }
  td { padding: 12px 16px; font-size: 0.875rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  tr:nth-child(even) { background: var(--bg); }
  .severity { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 600; color: #fff; }
  .severity.critical { background: var(--critical); }
  .severity.warn { background: var(--warn); }
  .severity.info { background: var(--info); }
  .sparkline { background: var(--surface); border: 1px solid var(--border); border-radius: 8px; display: block; }
  .empty { color: var(--ok); background: var(--surface); border: 1px dashed var(--ok); border-radius: 8px; padding: 24px; text-align: center; }
  footer { margin-top: 48px; color: var(--muted); font-size: 0.75rem; text-align: center; }
</style>
</head>
<body>
<div class="container">
  <h1>LogLens Report</h1>
  <p class="generated">Generated {{ report.generated_at.strftime('%Y-%m-%d %H:%M:%S UTC') }} · sources: {{ report.sources | join(', ') or '—' }}</p>

  <div class="cards">
    <div class="card"><div class="value">{{ report.total_events }}</div><div class="label">Events</div></div>
    <div class="card"><div class="value">{{ report.unknown_events }}</div><div class="label">Unparseable</div></div>
    <div class="card"><div class="value" style="color: {{ score_color }};">{{ report.health_score }}<span style="font-size:1rem;color:var(--muted)">/100</span></div><div class="label">Health score</div></div>
    <div class="card"><div class="value">{% if report.time_range.first %}{{ report.time_range.first.strftime('%H:%M') }}–{{ report.time_range.last.strftime('%H:%M') }}{% else %}—{% endif %}</div><div class="label">Time range</div></div>
  </div>

  <h2>Error rate over time</h2>
  {{ sparkline | safe }}

  <h2>Incidents ({{ report.incidents | length }})</h2>
  {% if report.incidents %}
  <table>
    <thead><tr><th>Severity</th><th>Rule</th><th>First seen</th><th>Summary</th><th>Suggested action</th></tr></thead>
    <tbody>
      {% for incident in report.incidents %}
      <tr>
        <td><span class="severity {{ severity_class[incident.severity] }}">{{ incident.severity }}</span></td>
        <td>{{ incident.rule }}</td>
        <td>{{ incident.first_seen.strftime('%H:%M:%S') }}</td>
        <td>{{ incident.summary }}</td>
        <td>{{ incident.suggested_action }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <div class="empty">No incidents detected — the logs look healthy.</div>
  {% endif %}

  <h2>Top messages</h2>
  <table>
    <thead><tr><th>Count</th><th>Level</th><th>Message</th></tr></thead>
    <tbody>
      {% for entry in report.top_messages %}
      <tr><td>{{ entry.count }}</td><td>{{ entry.level }}</td><td>{{ entry.message }}</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <footer>Generated by LogLens 1.0.0 — self-contained report, no external resources.</footer>
</div>
</body>
</html>
